# ==============================================================================
# AnzaBook - Local Docker & Container Environment Variables
# Copy to .env.docker or configure in your container runtime (Render / Koyeb / Docker)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (PostgreSQL)
# For local Docker Compose, use service name 'postgres':
POSTGRES_USER=anzabook
POSTGRES_PASSWORD=anzabook_local_secret
POSTGRES_DB=anzabook
POSTGRES_PORT=5432
DATABASE_URL=postgresql://anzabook:anzabook_local_secret@postgres:5432/anzabook

# Better Auth Secret (minimum 32-character secure random string)
BETTER_AUTH_SECRET=replace_with_a_secure_random_string_min_32_characters_long

# Origins & Routing
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000

# Proxy Trust (1 for single-hop load balancer/reverse proxy)
TRUST_PROXY=1

# Cloudflare R2 Object Storage (Covers & Manuscripts)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=anzabook-staging
# R2_PUBLIC_DOMAIN=https://assets-staging.anzabook.id

# Midtrans Payment Gateway (Sandbox)
# MIDTRANS_ENV=sandbox
# MIDTRANS_SERVER_KEY=SB-Mid-server-...
# MIDTRANS_CLIENT_KEY=SB-Mid-client-...
