# pnpm run setup creates private local values in .env.local (shared by both apps).
BETTER_AUTH_SECRET=
# Optional Google OAuth (Web application). Authorize BETTER_AUTH_URL + /api/auth/callback/google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public origin of the Express API. Better Auth issues cookies from here.
BETTER_AUTH_URL=http://localhost:4000
# Origin of the TanStack Start web app. Allowed by CORS and Better Auth.
WEB_URL=http://localhost:3000
# Optional extra comma-separated origins allowed to call the API with cookies.
# TRUSTED_ORIGINS=
# API origin the browser calls. Baked into the web build; keep it equal to BETTER_AUTH_URL.
VITE_API_URL=http://localhost:4000
# Optional API origin the web server uses during SSR (e.g. http://api:4000 in Docker).
# API_INTERNAL_URL=
# Production only: shared parent domain so app.example.com and api.example.com
# share the session cookie, e.g. .example.com. Leave unset for localhost.
# COOKIE_DOMAIN=
# Set when the API runs behind a reverse proxy: a hop count (e.g. 1) or subnets
# (e.g. loopback). Never true: that trusts any client-supplied X-Forwarded-For.
# TRUST_PROXY=
# fatal | error | warn | info | debug | trace | silent. Defaults: debug in dev, info in production.
# LOG_LEVEL=
# Log every SQL statement (parameters omitted) at debug level.
# LOG_SQL=false
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433
# Membership payment settings. Enable Other QRIS and configure
# /api/membership/webhooks/midtrans as the Midtrans payment notification URL.
# MIDTRANS_ENV=sandbox
# MIDTRANS_SERVER_KEY=
# Effective tax rate in basis points, added to the membership package subtotal.
# Sandbox defaults to 1100 for testing. Live payment requires an explicit rate.
# MEMBERSHIP_TAX_RATE_BPS=
# Optional Gmail or Workspace sender for membership reminders.
# The refresh token must authorize gmail.send for the sending mailbox.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM=
